# Builds the benchharness binary
#
# Why a separate Dockerfile:
# benchharness is normally a host-side tool, but its stub-serve subcommand also has to run *inside* the
# cluster as the backend an InferenceDeployment points at, which is what puts the real gateway in the
# middle of the M5-b measurement path (hack/m5b-gateway-path.sh).
# The controller and gateway images build different binaries, so reusing either would ship the wrong entrypoint.
FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
# Copy go.mod/go.sum first to cache the dependency layer.
# This avoids re-downloading dependencies when only the source changes.
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

# Copy the source (.dockerignore filters it).
COPY . .

# GOARCH is left without a default for the same reason as in the existing Dockerfile.
# Left empty, the build targets the platform of the host that runs it.
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o benchharness ./cmd/benchharness

# distroless: a minimal base image with no shell and no package manager, matching the gateway image.
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/benchharness .
USER 65532:65532

# stub-serve is baked into the entrypoint because the InferenceDeployment controller appends a fixed
# argument list (--model, --model-path) and offers no way to name a subcommand.
ENTRYPOINT ["/benchharness", "stub-serve"]
