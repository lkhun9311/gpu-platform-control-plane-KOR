{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyUnapprovedInstanceTypesOnRunInstances",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotLike": {
          "ec2:InstanceType": [
            "t3.*",
            "g4dn.*",
            "g5.*"
          ]
        }
      }
    },
    {
      "Sid": "DenyUnapprovedInstanceTypesOnLaunchTemplates",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateLaunchTemplate",
        "ec2:CreateLaunchTemplateVersion"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "ec2:InstanceType": [
            "t3.*",
            "g4dn.*",
            "g5.*"
          ]
        }
      }
    },
    {
      "Sid": "DenyUnapprovedInstanceTypesOnManagedNodeGroups",
      "Effect": "Deny",
      "Action": [
        "eks:CreateNodegroup"
      ],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringNotLike": {
          "eks:instanceTypes": [
            "t3.*",
            "g4dn.*",
            "g5.*"
          ]
        }
      }
    }
  ]
}
