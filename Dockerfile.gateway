# 게이트웨이 바이너리 빌드
#
# 왜 Dockerfile을 따로 두는가:
# 기존 Dockerfile은 cmd/main.go(컨트롤러)를 빌드해 manager 바이너리를 만든다.
# 게이트웨이는 별도의 프로세스이고 별도의 Deployment로 뜨므로 이미지도 따로여야 한다.
# 하나의 이미지에 두 바이너리를 넣으면 한쪽만 고쳐도 양쪽이 함께 재배포되고, 이미지도 불필요하게 커진다.
FROM golang:1.25 AS builder
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace
# go.mod/go.sum을 먼저 복사해 의존성 레이어를 캐시한다.
# 소스만 바뀔 때 의존성을 다시 내려받지 않게 해준다.
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

# 소스 복사(.dockerignore가 걸러낸다).
COPY . .

# GOARCH에 기본값을 두지 않는 이유는 기존 Dockerfile과 같다.
# 비워 두면 빌드를 실행한 호스트의 플랫폼에 맞춰 만들어진다.
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -a -o gateway cmd/gateway/main.go

# distroless: 셸도 패키지 관리자도 없는 최소 베이스 이미지다.
# 게이트웨이는 외부 트래픽을 직접 받는 컴포넌트라 공격 표면을 최대한 줄이는 것이 특히 중요하다.
FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/gateway .
USER 65532:65532

ENTRYPOINT ["/gateway"]
